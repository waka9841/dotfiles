# Whitelist: ignore everything, then re-allow listed paths.
# "!dir" re-includes the whole directory, so each allowed directory is
# immediately re-ignored with "dir/*" and only the listed children are allowed.
/*
/.**

!/.bin
/.bin/*
!/.bin/install.sh

!/.config
/.config/*
!/.config/direnv
/.config/direnv/*
!/.config/direnv/direnv.toml
!/.config/mise
/.config/mise/*
!/.config/mise/config.toml
!/.config/starship
/.config/starship/*
!/.config/starship/starship.toml
!/.config/wezterm
/.config/wezterm/*
!/.config/wezterm/wezterm.lua
!/.config/wezterm/keybinds.lua

!/.github
/.github/*
!/.github/workflows
/.github/workflows/*
!/.github/workflows/macos.yaml

!/.ssh
/.ssh/*
!/.ssh/config

!/.zsh
/.zsh/*
!/.zsh/git-prompt.sh

!/macos
/macos/*
!/macos/launchd
/macos/launchd/*
!/macos/launchd/com.user.autoreboot.plist

!/.gitignore
!/.zprofile
!/.zshrc
!/Brewfile
!/README.md

# Defensive blocks (the whitelist above already excludes these; listed for clarity)
*.local
.ssh/config.d/
.config/gcloud/
.config/k9s/
.config/iterm2/
.config/starship/contexts.local.toml
.config/starship/.merged.toml
**/credentials*
**/*.pem
**/id_rsa*
**/id_ed25519*
.DS_Store
_private_extract/
